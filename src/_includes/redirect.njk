<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Page moved — {{ site.name }}</title>
  {# GitHub Pages cannot issue a real 301, so this is a meta refresh plus a canonical hint. #}
  <meta http-equiv="refresh" content="0; url={{ to | url }}">
  <link rel="canonical" href="{{ (to | url) | absoluteUrl(site.url) }}">
  <meta name="robots" content="noindex">
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
</head>
<body>
  <main class="wrap" id="main">
    <h1>This page has moved</h1>
    <p>All projects now live on one page.</p>
    <p><a class="btn" href="{{ to | url }}">Continue to projects</a></p>
  </main>
</body>
</html>
